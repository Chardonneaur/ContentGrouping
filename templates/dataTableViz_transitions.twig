<div id="cgTransPage">

    <div class="card">
        <div class="card-content">
            <p>{{ 'ContentGrouping_GroupTransitionsDescription'|translate }}</p>
            <p class="card-description">{{ 'ContentGrouping_TransitionsDateHint'|translate }}</p>

            <div style="display:flex; gap:24px; flex-wrap:wrap; margin-top:16px; align-items:flex-end">
                <div>
                    <label for="cgMappingSelector">{{ 'ContentGrouping_SelectMapping'|translate }}</label><br>
                    <select id="cgMappingSelector" class="browser-default" style="min-width:200px; max-width:300px"></select>
                </div>
                <div>
                    <label for="cgGroupSelector">{{ 'ContentGrouping_TransitionsGroupCard'|translate }}</label><br>
                    <select id="cgGroupSelector" class="browser-default" style="min-width:200px; max-width:300px">
                        <option value="">—</option>
                    </select>
                </div>
                <div>
                    <button type="button" id="cgLoadBtn" class="btn">
                        {{ 'ContentGrouping_GroupTransitionsLoadButton'|translate }}
                    </button>
                </div>
            </div>

            <div id="cgNotice" class="alert" style="display:none; margin-top:12px"></div>
        </div>
    </div>

    <div id="cgTransContent" style="display:none">
        <div class="card">
            <div class="card-content">
                <p id="cgTransMeta" style="color:#586675; margin-bottom:12px"></p>

                <div id="cgTransEmpty" style="display:none">
                    <div class="alert alert-info">{{ 'ContentGrouping_GroupTransitionsEmpty'|translate }}</div>
                </div>

                <div id="cgTransResults" style="display:none">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px">
                        <div>
                            <h3 style="margin:0 0 12px">{{ 'ContentGrouping_GroupTransitionsPrevious'|translate }}</h3>
                            <table class="dataTable entityTable">
                                <thead><tr>
                                    <th>{{ 'ContentGrouping_GroupTransitionsGroup'|translate }}</th>
                                    <th>{{ 'ContentGrouping_GroupTransitionsCount'|translate }}</th>
                                </tr></thead>
                                <tbody id="cgTransPrevBody"></tbody>
                            </table>
                        </div>
                        <div>
                            <h3 style="margin:0 0 12px">{{ 'ContentGrouping_GroupTransitionsFollowing'|translate }}</h3>
                            <table class="dataTable entityTable">
                                <thead><tr>
                                    <th>{{ 'ContentGrouping_GroupTransitionsGroup'|translate }}</th>
                                    <th>{{ 'ContentGrouping_GroupTransitionsCount'|translate }}</th>
                                </tr></thead>
                                <tbody id="cgTransNextBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
(function () {
    var idSite  = {{ clientSideParameters.idSite|default(0)|intval }};
    var period  = '{{ clientSideParameters.period|default('day')|e('js') }}';
    var date    = '{{ clientSideParameters.date|default('today')|e('js') }}';
    var segment = '{{ clientSideParameters.segment|default('')|e('js') }}';

    function showNotice(type, msg) {
        $('#cgNotice')
            .removeClass('alert-danger alert-warning alert-success alert-info')
            .addClass('alert-' + (type === 'error' ? 'danger' : type))
            .text(msg)
            .show();
    }

    function hideNotice() {
        $('#cgNotice').hide();
    }

    function parseError(resp) {
        if (resp && resp.message) { return resp.message; }
        if (resp && resp.responseJSON && resp.responseJSON.message) { return resp.responseJSON.message; }
        return '{{ 'General_ErrorRequest'|translate|e('js') }}';
    }

    function api(method, params, cb, errCb) {
        var a = new ajaxHelper();
        a.addParams($.extend({ module: 'API', method: 'ContentGrouping.' + method, format: 'json' }, params), 'get');
        a.setCallback(function (resp) {
            if (resp && resp.result === 'error') {
                if (typeof errCb === 'function') { errCb(resp); } else { showNotice('error', resp.message || ''); }
                return;
            }
            cb(resp && resp.result === 'success' && typeof resp.value !== 'undefined' ? resp.value : resp);
        });
        a.setErrorCallback(function (resp) {
            if (typeof errCb === 'function') { errCb(resp); } else { showNotice('error', parseError(resp)); }
        });
        a.setFormat('json');
        a.send();
    }

    function normalizeArray(resp) {
        if ($.isArray(resp)) { return resp; }
        if (resp && $.isArray(resp.value)) { return resp.value; }
        return [];
    }

    function loadMappings() {
        api('getMappingsForReport', { idSite: idSite }, function (mappings) {
            mappings = normalizeArray(mappings);
            var sel = $('#cgMappingSelector').empty();
            $.each(mappings, function (i, m) {
                sel.append('<option value="' + piwikHelper.escape(m) + '">' + piwikHelper.escape(m) + '</option>');
            });
            loadGroups();
        });
    }

    function loadGroups() {
        var mapping = $('#cgMappingSelector').val() || 'default';
        api('getGroupNamesForReport', { idSite: idSite, mappingName: mapping }, function (groups) {
            groups = normalizeArray(groups);
            var sel = $('#cgGroupSelector').empty();
            sel.append('<option value="">—</option>');
            $.each(groups, function (i, name) {
                sel.append('<option value="' + piwikHelper.escape(name) + '">' + piwikHelper.escape(name) + '</option>');
            });
            $('#cgTransContent').hide();
        });
    }

    function loadTransitions() {
        var group = $('#cgGroupSelector').val();
        if (!group) {
            showNotice('error', '{{ 'ContentGrouping_GroupTransitionsSelectGroup'|translate|e('js') }}');
            return;
        }

        var params = {
            idSite:      idSite,
            period:      period,
            date:        date,
            groupName:   group,
            mappingName: $('#cgMappingSelector').val() || 'default'
        };
        if (segment) { params.segment = segment; }

        hideNotice();

        api('getGroupTransitions', params, function (res) {
            $('#cgTransContent').show();
            $('#cgTransMeta').text('{{ 'ContentGrouping_GroupTransitionsPageviews'|translate|e('js') }}: ' + (res.pageviews || 0));

            var prev = res.previousGroups  || [];
            var next = res.followingGroups || [];

            if (!prev.length && !next.length) {
                $('#cgTransResults').hide();
                $('#cgTransEmpty').show();
                return;
            }

            $('#cgTransEmpty').hide();

            var prevBody = $('#cgTransPrevBody').empty();
            $.each(prev, function (i, row) {
                prevBody.append(
                    '<tr><td>' + piwikHelper.escape(String(row.label)) +
                    '</td><td>' + piwikHelper.escape(String(row.nb)) + '</td></tr>'
                );
            });

            var nextBody = $('#cgTransNextBody').empty();
            $.each(next, function (i, row) {
                nextBody.append(
                    '<tr><td>' + piwikHelper.escape(String(row.label)) +
                    '</td><td>' + piwikHelper.escape(String(row.nb)) + '</td></tr>'
                );
            });

            $('#cgTransResults').show();
        });
    }

    $('#cgMappingSelector').on('change', loadGroups);
    $('#cgGroupSelector').on('change', function () {
        if ($(this).val()) { loadTransitions(); }
    });
    $('#cgLoadBtn').on('click', loadTransitions);

    loadMappings();
}());
</script>
