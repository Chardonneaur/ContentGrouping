{% extends 'admin.twig' %}

{% set title %}{{ 'ContentGrouping_ManageRules'|translate }}{% endset %}

{% block content %}
<style>
#contentGroupingAdmin {
    max-width: 1200px;
}

.cg-hero {
    margin-bottom: 20px;
    padding: 18px 20px;
    border-radius: 8px;
    background: linear-gradient(135deg, #f8fbff 0%, #eef6ff 100%);
    border: 1px solid #d4e3f7;
}

.cg-hero h2 {
    margin: 0 0 8px;
}

.cg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.cg-card {
    border: 1px solid #e1e8f0;
    border-radius: 8px;
    background: #fff;
    padding: 14px;
}

.cg-card h3 {
    margin: 0 0 10px;
    font-size: 16px;
}

.cg-inline {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
}

.cg-inline label {
    font-weight: 600;
    min-width: 70px;
}

.cg-note {
    margin-top: 8px;
    color: #586675;
    font-size: 12px;
}

#cgNotice {
    display: none;
    margin: 12px 0;
    padding: 10px 12px;
    border-radius: 6px;
    font-weight: 600;
}

#cgNotice.info {
    background: #e8f1ff;
    color: #1f4f8c;
    border: 1px solid #bfd6f5;
}

#cgNotice.success {
    background: #e9f8ef;
    color: #236f42;
    border: 1px solid #bde6cc;
}

#cgNotice.error {
    background: #fdeaea;
    color: #9f2d2d;
    border: 1px solid #f3bcbc;
}

.cg-toolbar {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.cg-summary {
    color: #4b5b6c;
    font-size: 13px;
}

.cg-badge {
    display: inline-block;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid transparent;
}

.cg-badge-prefix {
    color: #0f4f4d;
    background: #e4fbf9;
    border-color: #bfe8e3;
}

.cg-badge-regex {
    color: #624111;
    background: #fff6e2;
    border-color: #efd9a6;
}

.cg-result {
    font-weight: 600;
    color: #27384a;
}

.cg-result code {
    background: #f4f7fa;
    padding: 2px 6px;
    border-radius: 4px;
}

.cg-section {
    margin-top: 18px;
}

.cg-section-title {
    margin: 0 0 6px;
}
</style>

<div id="contentGroupingAdmin">
    <div class="cg-hero">
        <h2>{{ 'ContentGrouping_ManageRules'|translate }}</h2>
        <div class="description">{{ 'ContentGrouping_RulesDescription'|translate }}</div>
        <div class="cg-note">{{ 'ContentGrouping_MappingConflictHint'|translate }}</div>
    </div>

    <div id="cgNotice"></div>

    <div class="cg-grid">
        <div class="cg-card">
            <h3>{{ 'ContentGrouping_Step1Context'|translate }}</h3>
            <div class="cg-inline" style="margin-bottom:8px">
                <label for="cgSiteSelector">{{ 'ContentGrouping_SelectSite'|translate }}</label>
                <select id="cgSiteSelector" style="max-width:350px">
                    {% for site in sites %}
                        <option value="{{ site.idsite }}"{% if site.idsite == idSite %} selected{% endif %}>{{ site.name }} (id: {{ site.idsite }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="cg-inline">
                <label for="cgMappingSelector">{{ 'ContentGrouping_SelectMapping'|translate }}</label>
                <select id="cgMappingSelector" style="max-width:350px"></select>
            </div>
            <div class="cg-note">{{ 'ContentGrouping_MappingHint'|translate }}</div>
        </div>

        <div class="cg-card">
            <h3>{{ 'ContentGrouping_Step2CreateMapping'|translate }}</h3>
            <div class="cg-inline">
                <input type="text" id="cgNewMappingName" maxlength="100" placeholder="{{ 'ContentGrouping_NewMappingPlaceholder'|translate }}" style="max-width:280px">
                <button type="button" class="btn-flat" onclick="cgUseNewMapping()">{{ 'ContentGrouping_UseMapping'|translate }}</button>
            </div>
            <div class="cg-note">{{ 'ContentGrouping_NewMappingHint'|translate }}</div>
        </div>
    </div>

    <div id="cgList" class="cg-card">
        <div class="cg-toolbar">
            <button type="button" class="btn" onclick="cgShowCreate()">+ {{ 'ContentGrouping_AddRule'|translate }}</button>
            <div id="cgSummary" class="cg-summary"></div>
        </div>

        <div id="cgTableWrap">
            <table class="entityTable" id="cgTable">
                <thead><tr>
                    <th>{{ 'ContentGrouping_GroupName'|translate }}</th>
                    <th>{{ 'ContentGrouping_Pattern'|translate }}</th>
                    <th>{{ 'ContentGrouping_MatchType'|translate }}</th>
                    <th>{{ 'ContentGrouping_Priority'|translate }}</th>
                    <th>{{ 'ContentGrouping_Actions'|translate }}</th>
                </tr></thead>
                <tbody id="cgBody"></tbody>
            </table>
        </div>
        <div id="cgEmpty" style="display:none; padding:20px 0; color:#738496">
            <p>{{ 'ContentGrouping_NoRulesYet'|translate }}</p>
        </div>

        <div class="cg-section">
            <h3 class="cg-section-title">{{ 'ContentGrouping_TestUrl'|translate }}</h3>
            <div class="cg-inline" style="margin-bottom:4px">
                <input type="text" id="cgTestUrl" placeholder="{{ 'ContentGrouping_TestUrlPlaceholder'|translate }}" style="flex:1; max-width:560px">
                <button type="button" class="btn-flat" onclick="cgTestUrl()">{{ 'General_Test'|translate }}</button>
                <span id="cgTestResult" class="cg-result"></span>
            </div>
            <div class="cg-note">{{ 'ContentGrouping_TestHint'|translate }}</div>
        </div>

        <div class="cg-section">
            <h3 class="cg-section-title">{{ 'ContentGrouping_UnmappedPreviewTitle'|translate }}</h3>
            <p class="description">{{ 'ContentGrouping_UnmappedPreviewDescription'|translate }}</p>
            <div class="cg-inline" style="margin-bottom:8px;">
                <select id="cgPreviewPeriod" style="max-width:180px">
                    <option value="month">month</option>
                    <option value="week">week</option>
                    <option value="day">day</option>
                    <option value="year">year</option>
                    <option value="range" selected>range</option>
                </select>
                <input type="text" id="cgPreviewDate" value="last30" placeholder="today or YYYY-MM-DD or range" style="max-width:300px">
                <button type="button" class="btn-flat" onclick="cgPreviewUnmapped()">{{ 'ContentGrouping_UnmappedPreviewButton'|translate }}</button>
            </div>
            <div id="cgUnmappedMeta" class="cg-summary" style="margin-bottom:8px"></div>
            <div id="cgUnmappedEmpty" style="display:none; color:#738496; margin-bottom:12px">{{ 'ContentGrouping_UnmappedPreviewEmpty'|translate }}</div>
            <table class="entityTable" id="cgUnmappedTable" style="display:none; margin-bottom:20px">
                <thead><tr>
                    <th>URL</th>
                    <th>{{ 'General_ColumnPageviews'|translate }}</th>
                </tr></thead>
                <tbody id="cgUnmappedBody"></tbody>
            </table>
        </div>

        <div class="cg-section">
            <h3 class="cg-section-title">{{ 'ContentGrouping_GroupTransitionsTitle'|translate }}</h3>
            <p class="description">{{ 'ContentGrouping_GroupTransitionsDescription'|translate }}</p>
            <div class="cg-inline" style="margin-bottom:8px;">
                <select id="cgTransGroup" style="max-width:280px">
                    <option value="">— select group —</option>
                </select>
                <select id="cgTransPeriod" style="max-width:180px">
                    <option value="month">month</option>
                    <option value="week">week</option>
                    <option value="day">day</option>
                    <option value="year">year</option>
                    <option value="range" selected>range</option>
                </select>
                <input type="text" id="cgTransDate" value="last30" placeholder="today or YYYY-MM-DD or range" style="max-width:200px">
                <button type="button" class="btn-flat" onclick="cgLoadTransitions()">{{ 'ContentGrouping_GroupTransitionsLoadButton'|translate }}</button>
            </div>
            <div id="cgTransMeta" class="cg-summary" style="margin-bottom:8px"></div>
            <div id="cgTransEmpty" style="display:none; color:#738496; margin-bottom:12px">{{ 'ContentGrouping_GroupTransitionsEmpty'|translate }}</div>
            <div id="cgTransResults" style="display:none">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div>
                        <h4 style="margin:0 0 6px">{{ 'ContentGrouping_GroupTransitionsPrevious'|translate }}</h4>
                        <table class="entityTable" id="cgTransPrevTable">
                            <thead><tr>
                                <th>{{ 'ContentGrouping_GroupTransitionsGroup'|translate }}</th>
                                <th>{{ 'ContentGrouping_GroupTransitionsCount'|translate }}</th>
                            </tr></thead>
                            <tbody id="cgTransPrevBody"></tbody>
                        </table>
                    </div>
                    <div>
                        <h4 style="margin:0 0 6px">{{ 'ContentGrouping_GroupTransitionsFollowing'|translate }}</h4>
                        <table class="entityTable" id="cgTransNextTable">
                            <thead><tr>
                                <th>{{ 'ContentGrouping_GroupTransitionsGroup'|translate }}</th>
                                <th>{{ 'ContentGrouping_GroupTransitionsCount'|translate }}</th>
                            </tr></thead>
                            <tbody id="cgTransNextBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="cg-section">
            <h3 class="cg-section-title">{{ 'ContentGrouping_InvalidateTitle'|translate }}</h3>
            <p class="description">{{ 'ContentGrouping_InvalidateDescription'|translate }}</p>
            <div class="cg-inline">
                <button type="button" class="btn" id="cgInvalidateBtn" onclick="cgInvalidate()">{{ 'ContentGrouping_InvalidateButton'|translate }}</button>
                <span id="cgInvalidateResult" class="cg-summary"></span>
            </div>
        </div>
    </div>

    <div id="cgForm" style="display:none" class="cg-card">
        <h3 id="cgFormTitle" style="margin-top:0">{{ 'ContentGrouping_AddRule'|translate }}</h3>
        <input type="hidden" id="cgEditId" value="">

        <div style="margin-bottom:12px">
            <label>{{ 'ContentGrouping_MappingName'|translate }}</label><br>
            <input type="text" id="cgMappingName" maxlength="100" style="width:100%; max-width:460px">
        </div>
        <div style="margin-bottom:12px">
            <label>{{ 'ContentGrouping_GroupName'|translate }} *</label><br>
            <input type="text" id="cgGroupName" maxlength="255" style="width:100%; max-width:460px">
        </div>
        <div style="margin-bottom:12px">
            <label>{{ 'ContentGrouping_Pattern'|translate }} *</label><br>
            <input type="text" id="cgPattern" maxlength="500" style="width:100%; max-width:460px">
        </div>
        <div style="margin-bottom:12px">
            <label>{{ 'ContentGrouping_MatchType'|translate }}</label><br>
            <select id="cgMatchType" style="max-width:220px">
                <option value="prefix">{{ 'ContentGrouping_MatchTypePrefix'|translate }}</option>
                <option value="regex">{{ 'ContentGrouping_MatchTypeRegex'|translate }}</option>
            </select>
        </div>
        <div style="margin-bottom:16px">
            <label>{{ 'ContentGrouping_Priority'|translate }}</label><br>
            <input type="number" id="cgPriority" value="0" min="0" style="max-width:120px">
            <div class="cg-note">{{ 'ContentGrouping_PriorityHint'|translate }}</div>
        </div>

        <button type="button" class="btn" onclick="cgSave()">{{ 'ContentGrouping_Save'|translate }}</button>
        <button type="button" class="btn-flat" onclick="cgCancel()">{{ 'ContentGrouping_Cancel'|translate }}</button>
    </div>
</div>

<div class="ui-confirm" id="cgConfirmDelete">
    <h2>{{ 'General_AreYouSure'|translate }}</h2>
    <p>{{ 'ContentGrouping_DeleteRuleConfirm'|translate }}</p>
    <input role="yes" type="button" value="{{ 'General_Yes'|translate }}"/>
    <input role="no" type="button" value="{{ 'General_No'|translate }}"/>
</div>

<script>
$(function() {
    var currentMapping = 'default';

    function getSelectedSite() {
        return parseInt($('#cgSiteSelector').val(), 10);
    }

    function getSelectedMapping() {
        var fromSelect = $.trim($('#cgMappingSelector').val() || '');
        return fromSelect || currentMapping;
    }

    function normalizeApiArray(response) {
        if ($.isArray(response)) {
            return response;
        }
        if (response && $.isArray(response.value)) {
            return response.value;
        }
        return [];
    }

    function refreshSelectUi($select) {
        if (!$select || !$select.length) {
            return;
        }
        try {
            if (typeof $select.material_select === 'function') {
                $select.material_select('destroy');
                $select.material_select();
                return;
            }
            if (typeof $select.formSelect === 'function') {
                $select.formSelect();
            }
        } catch (e) {
            // Keep native select working if Materialize select refresh fails.
        }
    }

    function showNotice(type, message) {
        var box = $('#cgNotice');
        box.removeClass('info success error').addClass(type || 'info').text(message || '').show();
    }

    function hideNotice() {
        $('#cgNotice').hide().text('');
    }

    function parseErrorMessage(xhr) {
        if (xhr && xhr.message) {
            return xhr.message;
        }
        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
            return xhr.responseJSON.message;
        }
        if (xhr && xhr.responseText) {
            return xhr.responseText;
        }
        return '{{ 'General_ErrorRequest'|translate|e('js') }}';
    }

    function unwrapApiResponse(response) {
        if (response && response.result === 'error') {
            return { error: true, message: response.message || '{{ 'General_ErrorRequest'|translate|e('js') }}' };
        }
        if (response && response.result === 'success' && typeof response.value !== 'undefined') {
            return response.value;
        }
        return response;
    }

    function api(method, params, cb, errCb) {
        var a = new ajaxHelper();
        a.addParams($.extend({module:'API', method:'ContentGrouping.'+method, format:'json'}, params), 'get');
        a.setCallback(function(response) {
            var unwrapped = unwrapApiResponse(response);
            if (unwrapped && unwrapped.error) {
                if (typeof errCb === 'function') {
                    errCb(unwrapped);
                    return;
                }
                showNotice('error', parseErrorMessage(unwrapped));
                return;
            }
            cb(unwrapped);
        });
        a.setErrorCallback(function(xhr) {
            if (typeof errCb === 'function') {
                errCb(xhr);
                return;
            }
            showNotice('error', parseErrorMessage(xhr));
        });
        a.setFormat('json');
        a.send();
    }

    function apiPost(method, getP, postP, cb, errCb) {
        var a = new ajaxHelper();
        a.addParams($.extend({module:'API', method:'ContentGrouping.'+method, format:'json'}, getP), 'get');
        a.addParams(postP, 'post');
        a.setCallback(function(response) {
            var unwrapped = unwrapApiResponse(response);
            if (unwrapped && unwrapped.error) {
                if (typeof errCb === 'function') {
                    errCb(unwrapped);
                    return;
                }
                showNotice('error', parseErrorMessage(unwrapped));
                return;
            }
            cb(unwrapped);
        });
        a.setErrorCallback(function(xhr) {
            if (typeof errCb === 'function') {
                errCb(xhr);
                return;
            }
            showNotice('error', parseErrorMessage(xhr));
        });
        a.setFormat('json');
        a.send();
    }

    function renderSummary(rules) {
        var groupSet = {};
        $.each(rules || [], function(i, r) {
            groupSet[r.group_name] = true;
        });
        var groupsCount = Object.keys(groupSet).length;
        var msg = (rules ? rules.length : 0) + ' {{ 'ContentGrouping_RulesCountLabel'|translate|e('js') }} • ' + groupsCount + ' {{ 'ContentGrouping_GroupsCountLabel'|translate|e('js') }} • {{ 'ContentGrouping_SelectMapping'|translate|e('js') }} ' + getSelectedMapping();
        $('#cgSummary').text(msg);
    }

    function loadMappings(done) {
        api('getMappings', {idSite:getSelectedSite()}, function(mappings) {
            var select = $('#cgMappingSelector').empty();
            mappings = normalizeApiArray(mappings);
            var found = false;
            var firstMapping = null;

            if (mappings && mappings.length) {
                $.each(mappings, function(i, m) {
                    if (firstMapping === null) {
                        firstMapping = m;
                    }
                    var selected = (m === currentMapping);
                    if (selected) {
                        found = true;
                    }
                    select.append('<option value="' + piwikHelper.escape(m) + '"' + (selected ? ' selected' : '') + '>' + piwikHelper.escape(m) + '</option>');
                });
            }

            if (!found) {
                if (firstMapping !== null) {
                    currentMapping = firstMapping;
                    select.val(firstMapping);
                } else {
                    select.append('<option value="' + piwikHelper.escape(currentMapping) + '" selected>' + piwikHelper.escape(currentMapping) + '</option>');
                }
            }

            refreshSelectUi(select);

            if (typeof done === 'function') {
                done();
            }
        });
    }

    function loadList() {
        api('getRules', {idSite:getSelectedSite(), mappingName:getSelectedMapping()}, function(rules) {
            rules = normalizeApiArray(rules);
            var body = $('#cgBody').empty();
            renderSummary(rules || []);
            populateGroupSelector(rules || []);

            if (!rules || !rules.length) {
                $('#cgTableWrap').hide();
                $('#cgEmpty').show();
                return;
            }

            $('#cgTableWrap').show();
            $('#cgEmpty').hide();

            $.each(rules, function(i, r) {
                var isRegex = r.match_type === 'regex';
                var typeBadgeClass = isRegex ? 'cg-badge-regex' : 'cg-badge-prefix';
                var typeLabel = isRegex ? '{{ 'ContentGrouping_MatchTypeRegex'|translate|e('js') }}' : '{{ 'ContentGrouping_MatchTypePrefix'|translate|e('js') }}';

                body.append(
                    '<tr>' +
                        '<td><strong>' + piwikHelper.escape(r.group_name) + '</strong></td>' +
                        '<td><code>' + piwikHelper.escape(r.pattern) + '</code></td>' +
                        '<td><span class="cg-badge ' + typeBadgeClass + '">' + typeLabel + '</span></td>' +
                        '<td>' + piwikHelper.escape(String(r.priority)) + '</td>' +
                        '<td>' +
                            '<button type="button" class="btn-flat btn-small" onclick="cgEditItem(' + r.idrule + ')">{{ 'ContentGrouping_Edit'|translate|e('js') }}</button> ' +
                            '<button type="button" class="btn-flat btn-small" style="color:#c62828" onclick="cgDelItem(' + r.idrule + ')">{{ 'ContentGrouping_Delete'|translate|e('js') }}</button>' +
                        '</td>' +
                    '</tr>'
                );
            });
        });
    }

    function resetSecondaryPanels() {
        $('#cgTestResult').text('');
        $('#cgInvalidateResult').text('');
        $('#cgUnmappedMeta').text('');
        $('#cgUnmappedTable').hide();
        $('#cgUnmappedEmpty').hide();
        $('#cgTransMeta').text('');
        $('#cgTransResults').hide();
        $('#cgTransEmpty').hide();
    }

    $('#cgSiteSelector').on('change', function() {
        hideNotice();
        resetSecondaryPanels();
        cgCancel();
        currentMapping = 'default';
        loadMappings(loadList);
    });

    $('#cgMappingSelector').on('change', function() {
        hideNotice();
        currentMapping = getSelectedMapping();
        resetSecondaryPanels();
        cgCancel();
        loadList();
    });

    window.cgShowCreate = function() {
        hideNotice();
        $('#cgEditId').val('');
        $('#cgGroupName').val('');
        $('#cgPattern').val('');
        $('#cgMatchType').val('prefix');
        $('#cgPriority').val('0');
        $('#cgMappingName').val(getSelectedMapping());
        $('#cgFormTitle').text('{{ 'ContentGrouping_AddRule'|translate|e('js') }}');
        $('#cgList').hide();
        $('#cgForm').show();
    };

    window.cgEditItem = function(id) {
        hideNotice();
        api('getRules', {idSite:getSelectedSite(), mappingName:getSelectedMapping()}, function(rules) {
            var rule = null;
            $.each(rules, function(i, r) {
                if (parseInt(r.idrule, 10) === id) {
                    rule = r;
                }
            });
            if (!rule) {
                return;
            }

            $('#cgEditId').val(rule.idrule);
            $('#cgMappingName').val(rule.mapping_name || getSelectedMapping());
            $('#cgGroupName').val(rule.group_name);
            $('#cgPattern').val(rule.pattern);
            $('#cgMatchType').val(rule.match_type);
            $('#cgPriority').val(rule.priority);
            $('#cgFormTitle').text('{{ 'ContentGrouping_EditRule'|translate|e('js') }}');
            $('#cgList').hide();
            $('#cgForm').show();
        });
    };

    window.cgCancel = function() {
        $('#cgForm').hide();
        $('#cgList').show();
    };

    window.cgSave = function() {
        hideNotice();

        var groupName = $.trim($('#cgGroupName').val());
        var pattern = $.trim($('#cgPattern').val());
        var matchType = $('#cgMatchType').val();
        var priority = parseInt($('#cgPriority').val(), 10) || 0;
        var mappingName = $.trim($('#cgMappingName').val()) || getSelectedMapping();
        var idRule = $('#cgEditId').val();

        if (!groupName || !pattern) {
            showNotice('error', '{{ 'ContentGrouping_RequiredFieldsMessage'|translate|e('js') }}');
            return;
        }

        var payload = {
            idSite: getSelectedSite(),
            mappingName: mappingName,
            groupName: groupName,
            pattern: pattern,
            matchType: matchType,
            priority: priority
        };

        var onSuccess = function() {
            currentMapping = mappingName;
            loadMappings(function() {
                cgCancel();
                loadList();
                showNotice('success', '{{ 'ContentGrouping_RuleSaved'|translate|e('js') }}');
            });
        };

        var onError = function(xhr) {
            showNotice('error', parseErrorMessage(xhr));
        };

        if (idRule) {
            payload.idRule = idRule;
            apiPost('updateRule', {}, payload, onSuccess, onError);
        } else {
            apiPost('addRule', {}, payload, onSuccess, onError);
        }
    };

    window.cgDelItem = function(id) {
        hideNotice();
        piwikHelper.modalConfirm('#cgConfirmDelete', {
            yes: function() {
                apiPost('deleteRule', {}, {idSite:getSelectedSite(), idRule:id}, function() {
                    loadMappings(loadList);
                    showNotice('info', '{{ 'ContentGrouping_RuleDeleted'|translate|e('js') }}');
                });
            }
        });
    };

    window.cgTestUrl = function() {
        hideNotice();
        var url = $.trim($('#cgTestUrl').val());
        if (!url) {
            showNotice('error', '{{ 'ContentGrouping_TestUrlRequired'|translate|e('js') }}');
            return;
        }

        api('testUrl', {idSite:getSelectedSite(), mappingName:getSelectedMapping(), url:url}, function(res) {
            var result = (res && res.group) ? res.group : '{{ 'General_Others'|translate|e('js') }}';
            $('#cgTestResult').html('{{ 'ContentGrouping_TestResultLabel'|translate|e('js') }}: <code>' + piwikHelper.escape(result) + '</code>');
        });
    };

    window.cgUseNewMapping = function() {
        hideNotice();
        var newMapping = $.trim($('#cgNewMappingName').val());
        if (!newMapping) {
            showNotice('error', '{{ 'ContentGrouping_NewMappingRequired'|translate|e('js') }}');
            return;
        }

        apiPost('createMapping', {}, {idSite:getSelectedSite(), mappingName:newMapping}, function(res) {
            currentMapping = (res && res.mapping) ? res.mapping : newMapping;
            $('#cgNewMappingName').val('');
            loadMappings(function() {
                loadList();
                showNotice('info', '{{ 'ContentGrouping_NewMappingSelected'|translate|e('js') }} ' + currentMapping);
            });
        }, function(xhr) {
            showNotice('error', parseErrorMessage(xhr));
        });
    };

    window.cgPreviewUnmapped = function() {
        hideNotice();
        var period = $('#cgPreviewPeriod').val();
        var date = $.trim($('#cgPreviewDate').val()) || 'last30';

        api('previewUnmappedPages', {
            idSite:getSelectedSite(),
            mappingName:getSelectedMapping(),
            period:period,
            date:date,
            limit:50
        }, function(res) {
            var rows = (res && res.rows) ? res.rows : [];
            $('#cgUnmappedMeta').text('{{ 'ContentGrouping_PeriodLabel'|translate|e('js') }}: ' + (res.start || '?') + ' -> ' + (res.end || '?'));

            var body = $('#cgUnmappedBody').empty();
            if (!rows.length) {
                $('#cgUnmappedTable').hide();
                $('#cgUnmappedEmpty').show();
                return;
            }

            $('#cgUnmappedEmpty').hide();
            $.each(rows, function(i, r) {
                body.append('<tr><td><code>' + piwikHelper.escape(r.url) + '</code></td><td>' + piwikHelper.escape(String(r.nb_hits || 0)) + '</td></tr>');
            });
            $('#cgUnmappedTable').show();
        });
    };

    function populateGroupSelector(rules) {
        var select = $('#cgTransGroup').empty();
        select.append('<option value="">— select group —</option>');
        var seen = {};
        $.each(rules || [], function(i, r) {
            if (!seen[r.group_name]) {
                seen[r.group_name] = true;
                select.append('<option value="' + piwikHelper.escape(r.group_name) + '">' + piwikHelper.escape(r.group_name) + '</option>');
            }
        });
        refreshSelectUi(select);
    }

    window.cgLoadTransitions = function() {
        hideNotice();
        var group = $('#cgTransGroup').val();
        var period = $('#cgTransPeriod').val();
        var date = $.trim($('#cgTransDate').val()) || 'last30';

        if (!group) {
            showNotice('error', '{{ 'ContentGrouping_GroupTransitionsSelectGroup'|translate|e('js') }}');
            return;
        }

        api('getGroupTransitions', {
            idSite: getSelectedSite(),
            mappingName: getSelectedMapping(),
            period: period,
            date: date,
            groupName: group
        }, function(res) {
            $('#cgTransEmpty').hide();
            $('#cgTransResults').hide();
            $('#cgTransMeta').text('');

            if (!res) { return; }

            $('#cgTransMeta').text('{{ 'ContentGrouping_GroupTransitionsPageviews'|translate|e('js') }}: ' + (res.pageviews || 0));

            var prev = res.previousGroups || [];
            var next = res.followingGroups || [];

            if (!prev.length && !next.length) {
                $('#cgTransEmpty').show();
                return;
            }

            var prevBody = $('#cgTransPrevBody').empty();
            $.each(prev, function(i, row) {
                prevBody.append('<tr><td>' + piwikHelper.escape(row.label) + '</td><td>' + piwikHelper.escape(String(row.nb)) + '</td></tr>');
            });

            var nextBody = $('#cgTransNextBody').empty();
            $.each(next, function(i, row) {
                nextBody.append('<tr><td>' + piwikHelper.escape(row.label) + '</td><td>' + piwikHelper.escape(String(row.nb)) + '</td></tr>');
            });

            $('#cgTransResults').show();
        });
    };

    window.cgInvalidate = function() {
        hideNotice();
        var btn = $('#cgInvalidateBtn');
        var result = $('#cgInvalidateResult');
        btn.prop('disabled', true);
        result.css('color', '').text('{{ 'ContentGrouping_InvalidateProcessing'|translate|e('js') }}');

        apiPost('invalidateReports', {}, {idSite:getSelectedSite()}, function(res) {
            btn.prop('disabled', false);
            if (res && res.success) {
                result.css('color', '#2e7d32').text(res.message || '{{ 'ContentGrouping_InvalidateSuccess'|translate|e('js') }}');
                showNotice('success', '{{ 'ContentGrouping_InvalidateSuccess'|translate|e('js') }}');
            } else {
                result.css('color', '#c62828').text('{{ 'ContentGrouping_InvalidateError'|translate|e('js') }}');
                showNotice('error', '{{ 'ContentGrouping_InvalidateError'|translate|e('js') }}');
            }
        }, function(xhr) {
            btn.prop('disabled', false);
            result.css('color', '#c62828').text('{{ 'ContentGrouping_InvalidateError'|translate|e('js') }}');
            showNotice('error', parseErrorMessage(xhr));
        });
    };

    loadMappings(loadList);
});
</script>
{% endblock %}
